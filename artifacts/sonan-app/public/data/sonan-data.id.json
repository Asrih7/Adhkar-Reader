[
  {
    "sonaId": "1",
    "text": "Tidur dengan wudhu"
  },
  {
    "sonaId": "2",
    "text": "Bacalah Surat Al-Ikhlas dan Al-Mu'awwidhatayn sebelum tidur"
  },
  {
    "sonaId": "3",
    "text": "Takbir dan pemuliaan dalam mimpi"
  },
  {
    "sonaId": "4",
    "text": "Doa saat bangun tidur"
  },
  {
    "sonaId": "5",
    "text": "Doa ketika bangun dari tidur dengan doa yang disebutkan"
  },
  {
    "sonaId": "6",
    "text": "Membilas dan menghirup dari satu ruangan"
  },
  {
    "sonaId": "7",
    "text": "Berwudhu sebelum dicuci"
  },
  {
    "sonaId": "8",
    "text": "Tashahhud setelah wudhu"
  },
  {
    "sonaId": "9",
    "text": "Ekonomi air"
  },
  {
    "sonaId": "10",
    "text": "Sholat dua rakaat setelah wudhu"
  },
  {
    "sonaId": "11",
    "text": "Bernyanyi bersama muazin, lalu mendoakan Nabi SAW, semoga Tuhan memberkatinya dan memberinya kedamaian"
  },
  {
    "sonaId": "12",
    "text": "Gunakan siwak yang banyak"
  },
  {
    "sonaId": "13",
    "text": "Tiba lebih awal ke masjid"
  },
  {
    "sonaId": "14",
    "text": "Pergi ke masjid dengan berjalan kaki"
  },
  {
    "sonaId": "15",
    "text": "Lakukanlah shalat dengan tenang dan bermartabat"
  },
  {
    "sonaId": "16",
    "text": "Doa saat masuk dan keluar masjid"
  },
  {
    "sonaId": "17",
    "text": "Doa untuk Sitra"
  },
  {
    "sonaId": "18",
    "text": "Duduklah di antara dua sujud"
  },
  {
    "sonaId": "19",
    "text": "Turki pada tashahhud kedua"
  },
  {
    "sonaId": "20",
    "text": "Perbanyaklah berdoa sebelum melahirkan"
  },
  {
    "sonaId": "21",
    "text": "Pemenuhan norma gaji"
  },
  {
    "sonaId": "22",
    "text": "Sholat Dhuha"
  },
  {
    "sonaId": "23",
    "text": "Sholat malam"
  },
  {
    "sonaId": "24",
    "text": "Sholat witir"
  },
  {
    "sonaId": "25",
    "text": "Berdoa dengan sandal jika kesuciannya tercapai"
  },
  {
    "sonaId": "26",
    "text": "Sholat di Masjid Quba"
  },
  {
    "sonaId": "27",
    "text": "Melaksanakan shalat sunah di rumah"
  },
  {
    "sonaId": "28",
    "text": "Sholat Istikharah"
  },
  {
    "sonaId": "29",
    "text": "Duduk di area sholat setelah sholat subuh hingga matahari terbit"
  },
  {
    "sonaId": "30",
    "text": "Mandi di hari Jumat"
  },
  {
    "sonaId": "31",
    "text": "Datang lebih awal untuk salat Jumat"
  },
  {
    "sonaId": "32",
    "text": "Periksa waktu jawaban pada hari Jumat"
  },
  {
    "sonaId": "33",
    "text": "Pergi ke mushola Idul Fitri melalui satu jalan, dan kembali melalui jalan lain"
  },
  {
    "sonaId": "34",
    "text": "Berdoa untuk pemakaman"
  },
  {
    "sonaId": "35",
    "text": "Kunjungi kuburan"
  },
  {
    "sonaId": "36",
    "text": "Sahur"
  },
  {
    "sonaId": "37",
    "text": "Bersegera berbuka, jika matahari telah terbenam"
  },
  {
    "sonaId": "38",
    "text": "Doa Ramadhan"
  },
  {
    "sonaId": "39",
    "text": "Itikaf pada bulan Ramadhan, khususnya pada sepuluh hari terakhirnya"
  },
  {
    "sonaId": "40",
    "text": "Puasa enam hari di bulan Syawal"
  },
  {
    "sonaId": "41",
    "text": "Puasa tiga hari setiap bulannya"
  },
  {
    "sonaId": "42",
    "text": "Puasa di hari Arafat"
  },
  {
    "sonaId": "43",
    "text": "Puasa di hari Asyura"
  },
  {
    "sonaId": "44",
    "text": "Memilih seorang pangeran untuk bepergian"
  },
  {
    "sonaId": "45",
    "text": "Muliakan Tuhan saat naik dan muliakan Tuhan saat turun"
  },
  {
    "sonaId": "46",
    "text": "Doa saat turun di sebuah rumah"
  },
  {
    "sonaId": "47",
    "text": "Mulailah dari masjid jika Anda telah kembali dari perjalanan"
  },
  {
    "sonaId": "48",
    "text": "Doa saat memakai baju baru"
  },
  {
    "sonaId": "49",
    "text": "Memakai sandal di sebelah kanan"
  },
  {
    "sonaId": "50",
    "text": "Memberi nama sambil makan"
  },
  {
    "sonaId": "51",
    "text": "Puji Tuhan setelah makan dan minum"
  },
  {
    "sonaId": "52",
    "text": "Duduk saat minum"
  },
  {
    "sonaId": "53",
    "text": "Berkumur dengan susu"
  },
  {
    "sonaId": "54",
    "text": "Tidak ada yang salah dengan makanannya"
  },
  {
    "sonaId": "55",
    "text": "Makan dengan tiga jari"
  },
  {
    "sonaId": "56",
    "text": "Minum dan memulihkan diri dari air Zamzam"
  },
  {
    "sonaId": "57",
    "text": "Makan di hari raya idul fitri sebelum sholat"
  },
  {
    "sonaId": "58",
    "text": "Baca lebih lanjut Al-Qur'an"
  },
  {
    "sonaId": "59",
    "text": "Perbaiki suara Anda dengan membaca Al-Qur'an"
  },
  {
    "sonaId": "60",
    "text": "Ingatlah Tuhan dalam segala situasi"
  },
  {
    "sonaId": "61",
    "text": "Memuji"
  },
  {
    "sonaId": "62",
    "text": "Orang yang bersin itu menyombongkan diri"
  },
  {
    "sonaId": "63",
    "text": "Berdoalah untuk pasien tersebut"
  },
  {
    "sonaId": "64",
    "text": "Meletakkan tangan pada tempat yang sakit sambil berdoa"
  },
  {
    "sonaId": "65",
    "text": "Doa ketika mendengar ayam berkokok, dan mencari perlindungan ketika mendengar ringkikan keledai"
  },
  {
    "sonaId": "66",
    "text": "Doa ketika hujan turun"
  },
  {
    "sonaId": "67",
    "text": "Ingatlah Tuhan ketika memasuki rumah"
  },
  {
    "sonaId": "68",
    "text": "Sebutkan Tuhan di dewan"
  },
  {
    "sonaId": "69",
    "text": "Doa saat masuk toilet"
  },
  {
    "sonaId": "70",
    "text": "Berdoalah ketika angin bertiup"
  },
  {
    "sonaId": "71",
    "text": "Berdoalah ketika angin bertiup"
  },
  {
    "sonaId": "72",
    "text": "Doa di saat musibah"
  },
  {
    "sonaId": "73",
    "text": "Mengungkapkan perdamaian"
  },
  {
    "sonaId": "74",
    "text": "Mencari ilmu"
  },
  {
    "sonaId": "75",
    "text": "Minta izin tiga kali sebelum masuk"
  },
  {
    "sonaId": "76",
    "text": "Matematika bayi baru lahir"
  },
  {
    "sonaId": "77",
    "text": "Aqiqah untuk bayi yang baru lahir"
  },
  {
    "sonaId": "78",
    "text": "Mengekspos sebagian tubuh agar hujan bisa menerpanya"
  },
  {
    "sonaId": "79",
    "text": "Klinik pasien"
  },
  {
    "sonaId": "80",
    "text": "Tersenyum"
  },
  {
    "sonaId": "81",
    "text": "Mengunjungi Tuhan"
  },
  {
    "sonaId": "82",
    "text": "Seorang pria memberi tahu saudaranya bahwa dia mencintainya"
  },
  {
    "sonaId": "83",
    "text": "Dia menjawab sambil menguap"
  },
  {
    "sonaId": "84",
    "text": "Berpikir baik tentang orang lain"
  },
  {
    "sonaId": "85",
    "text": "Membantu orang tua mengerjakan pekerjaan rumah"
  },
  {
    "sonaId": "86",
    "text": "Sunnah Fitrah"
  },
  {
    "sonaId": "87",
    "text": "Sponsor anak yatim"
  },
  {
    "sonaId": "88",
    "text": "Hindari kemarahan"
  },
  {
    "sonaId": "89",
    "text": "Menangis karena takut akan Tuhan"
  },
  {
    "sonaId": "90",
    "text": "Amal yang berkelanjutan"
  },
  {
    "sonaId": "91",
    "text": "Membangun masjid"
  },
  {
    "sonaId": "92",
    "text": "Toleransi dalam jual beli"
  },
  {
    "sonaId": "93",
    "text": "Menghilangkan kerusakan di jalan"
  },
  {
    "sonaId": "94",
    "text": "Amal"
  },
  {
    "sonaId": "95",
    "text": "Perbanyaklah amal shaleh di sepuluh hari Dzulhijjah"
  },
  {
    "sonaId": "96",
    "text": "Bunuh tokek itu"
  },
  {
    "sonaId": "97",
    "text": "Dilarang menceritakan kepada seseorang segala sesuatu yang didengarnya"
  },
  {
    "sonaId": "98",
    "text": "Menghitung tunjangan untuk keluarga"
  },
  {
    "sonaId": "99",
    "text": "Pasir dalam keadaan mengelilingi"
  },
  {
    "sonaId": "100",
    "text": "Teruslah berbuat baik, meskipun kecil"
  }
]