[
  {
    "sonaId": "1",
    "text": "Abdestli uyumak"
  },
  {
    "sonaId": "2",
    "text": "Uyumadan önce İhlas Suresi ve Muavvizeteyn Suresi'ni okuyun"
  },
  {
    "sonaId": "3",
    "text": "Rüyada tekbir ve tesbih"
  },
  {
    "sonaId": "4",
    "text": "Uyurken Uyanırken Okunacak Dua"
  },
  {
    "sonaId": "5",
    "text": "Bahsedilen dua ile uykudan uyanıldığında yapılan dua"
  },
  {
    "sonaId": "6",
    "text": "Bir odadan durulama ve teneffüs etme"
  },
  {
    "sonaId": "7",
    "text": "Yıkamadan önce abdest"
  },
  {
    "sonaId": "8",
    "text": "Abdestten sonra teşehhüd"
  },
  {
    "sonaId": "9",
    "text": "Su ekonomisi"
  },
  {
    "sonaId": "10",
    "text": "Abdestten sonra iki rekat namaz kılmak"
  },
  {
    "sonaId": "11",
    "text": "Müezzin eşliğinde ilahiler okunuyor, ardından Peygamber sallallahu aleyhi ve sellem'e dua ediliyor."
  },
  {
    "sonaId": "12",
    "text": "Çok fazla misvak kullanın"
  },
  {
    "sonaId": "13",
    "text": "Camiye erken gelmek"
  },
  {
    "sonaId": "14",
    "text": "Yürüyerek camiye gitmek"
  },
  {
    "sonaId": "15",
    "text": "Namazı huzur ve itibarla kılın"
  },
  {
    "sonaId": "16",
    "text": "Camiye girerken ve çıkarken okunacak dua"
  },
  {
    "sonaId": "17",
    "text": "Sitra'ya dua"
  },
  {
    "sonaId": "18",
    "text": "İki secde arasında oturun"
  },
  {
    "sonaId": "19",
    "text": "İkinci teşehhüdde Türk"
  },
  {
    "sonaId": "20",
    "text": "Doğumdan önce bol bol dua edin"
  },
  {
    "sonaId": "21",
    "text": "Maaş normlarının yerine getirilmesi"
  },
  {
    "sonaId": "22",
    "text": "Dhuha duası"
  },
  {
    "sonaId": "23",
    "text": "Gece namazı"
  },
  {
    "sonaId": "24",
    "text": "Vitr namazı"
  },
  {
    "sonaId": "25",
    "text": "Temizlik sağlanmışsa sandaletlerle namaz kılmak"
  },
  {
    "sonaId": "26",
    "text": "Kuba Mescidi'nde namaz kılmak"
  },
  {
    "sonaId": "27",
    "text": "Evde nafile namaz kılmak"
  },
  {
    "sonaId": "28",
    "text": "İstikhara namazı"
  },
  {
    "sonaId": "29",
    "text": "Sabah namazından sonra güneş doğuncaya kadar mescidde oturmak"
  },
  {
    "sonaId": "30",
    "text": "Cuma günü banyo yapmak"
  },
  {
    "sonaId": "31",
    "text": "Cuma namazına erken gitmek"
  },
  {
    "sonaId": "32",
    "text": "Cuma günü cevap süresini kontrol edin"
  },
  {
    "sonaId": "33",
    "text": "Bir taraftan bayram namazına gidin, diğer taraftan dönün"
  },
  {
    "sonaId": "34",
    "text": "Cenaze için dua ediyorum"
  },
  {
    "sonaId": "35",
    "text": "Mezarlıkları ziyaret edin"
  },
  {
    "sonaId": "36",
    "text": "Sahur"
  },
  {
    "sonaId": "37",
    "text": "Güneş batmışsa orucu açmada acele etmek"
  },
  {
    "sonaId": "38",
    "text": "Ramazan namazı"
  },
  {
    "sonaId": "39",
    "text": "Ramazan ayında özellikle son on gününde itikaf"
  },
  {
    "sonaId": "40",
    "text": "Şevval ayının altı günü oruç tutmak"
  },
  {
    "sonaId": "41",
    "text": "Her ayın üç günü oruç tutmak"
  },
  {
    "sonaId": "42",
    "text": "Arafat günü oruç tutmak"
  },
  {
    "sonaId": "43",
    "text": "Aşure günü oruç tutmak"
  },
  {
    "sonaId": "44",
    "text": "Seyahat edecek prensi seçmek"
  },
  {
    "sonaId": "45",
    "text": "Yükselirken Allah'ı tesbih edin, inerken Allah'ı tesbih edin"
  },
  {
    "sonaId": "46",
    "text": "Bir eve inerken yapılacak dua"
  },
  {
    "sonaId": "47",
    "text": "Seyahatten döndüyseniz camiden başlayın"
  },
  {
    "sonaId": "48",
    "text": "Yeni elbise giyerken okunacak dua"
  },
  {
    "sonaId": "49",
    "text": "Sağdaki sandaleti giymek"
  },
  {
    "sonaId": "50",
    "text": "Yemek yerken isim vermek"
  },
  {
    "sonaId": "51",
    "text": "Yedikten ve içtikten sonra Allah'a şükredin"
  },
  {
    "sonaId": "52",
    "text": "İçerken oturmak"
  },
  {
    "sonaId": "53",
    "text": "Sütle gargara yapmak"
  },
  {
    "sonaId": "54",
    "text": "Yemekte yanlış bir şey yok"
  },
  {
    "sonaId": "55",
    "text": "Üç parmakla yemek yemek"
  },
  {
    "sonaId": "56",
    "text": "Zemzem suyunu içmek ve şifa bulmak"
  },
  {
    "sonaId": "57",
    "text": "Ramazan Bayramı'nda namaza gitmeden önce yemek yemek"
  },
  {
    "sonaId": "58",
    "text": "Kuran'ın devamını oku"
  },
  {
    "sonaId": "59",
    "text": "Kur'an okuyarak sesinizi geliştirmek"
  },
  {
    "sonaId": "60",
    "text": "Her durumda Allah'ı hatırla"
  },
  {
    "sonaId": "61",
    "text": "Övmek"
  },
  {
    "sonaId": "62",
    "text": "Hapşıran övündü"
  },
  {
    "sonaId": "63",
    "text": "Hasta için dua edin"
  },
  {
    "sonaId": "64",
    "text": "Dua ederken eli ağrıyan yere koymak"
  },
  {
    "sonaId": "65",
    "text": "Horozun ötüşünü duyunca dua etmek, eşeğin anırmasını duyunca sığınmak"
  },
  {
    "sonaId": "66",
    "text": "Yağmur yağdığında yapılan dua"
  },
  {
    "sonaId": "67",
    "text": "Eve girerken Allah'ı hatırla"
  },
  {
    "sonaId": "68",
    "text": "Mecliste Allah'ın anılması"
  },
  {
    "sonaId": "69",
    "text": "Tuvalete girerken okunacak dua"
  },
  {
    "sonaId": "70",
    "text": "Rüzgar estiğinde dua et"
  },
  {
    "sonaId": "71",
    "text": "Rüzgar estiğinde dua et"
  },
  {
    "sonaId": "72",
    "text": "Felaket zamanlarında yapılan dua"
  },
  {
    "sonaId": "73",
    "text": "Barışı ifşa etmek"
  },
  {
    "sonaId": "74",
    "text": "Bilgi arayışı"
  },
  {
    "sonaId": "75",
    "text": "Girmeden önce üç kez izin isteyin"
  },
  {
    "sonaId": "76",
    "text": "Yenidoğanın matematiği"
  },
  {
    "sonaId": "77",
    "text": "Yeni doğan için aqeeqah"
  },
  {
    "sonaId": "78",
    "text": "Yağmurun vurabilmesi için vücudun bir kısmını açığa çıkarmak"
  },
  {
    "sonaId": "79",
    "text": "Hasta kliniği"
  },
  {
    "sonaId": "80",
    "text": "Gülümseyen"
  },
  {
    "sonaId": "81",
    "text": "Tanrı'yı ​​ziyaret etmek"
  },
  {
    "sonaId": "82",
    "text": "Bir adam kardeşine onu sevdiğini söylüyor"
  },
  {
    "sonaId": "83",
    "text": "Esneyerek cevap verdi"
  },
  {
    "sonaId": "84",
    "text": "İnsanlar hakkında iyi düşünmek"
  },
  {
    "sonaId": "85",
    "text": "Ebeveynlere ev işlerinde yardımcı olmak"
  },
  {
    "sonaId": "86",
    "text": "Fitre Sünneti"
  },
  {
    "sonaId": "87",
    "text": "Yetim sponsorluğu"
  },
  {
    "sonaId": "88",
    "text": "Öfkeden kaçının"
  },
  {
    "sonaId": "89",
    "text": "Allah korkusundan ağlıyor"
  },
  {
    "sonaId": "90",
    "text": "Devam eden yardım"
  },
  {
    "sonaId": "91",
    "text": "Cami inşa etmek"
  },
  {
    "sonaId": "92",
    "text": "Alım satımda hoşgörü"
  },
  {
    "sonaId": "93",
    "text": "Yoldaki zararın giderilmesi"
  },
  {
    "sonaId": "94",
    "text": "Hayır kurumu"
  },
  {
    "sonaId": "95",
    "text": "Zilhicce'nin on gününde çok iyilik yapın"
  },
  {
    "sonaId": "96",
    "text": "Geko'yu öldür"
  },
  {
    "sonaId": "97",
    "text": "Bir insana duyduğu her şeyi anlatmak yasaktır"
  },
  {
    "sonaId": "98",
    "text": "Aile nafakasının hesaplanması"
  },
  {
    "sonaId": "99",
    "text": "Tavafta kum"
  },
  {
    "sonaId": "100",
    "text": "Küçük de olsa iyilik yapmaya devam etmek"
  }
]